# Единственный администратор: войдёт по коду на эту почту
ADMIN_EMAIL=you@example.com

# --- Почта, ОТКУДА уходят коды и уведомления (выберите один вариант) ---
# Яндекс:
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=you@yandex.ru
SMTP_PASS=пароль-приложения
MAIL_FROM=Logistic Center <you@yandex.ru>
# Gmail:    SMTP_HOST=smtp.gmail.com   SMTP_PORT=465  (пароль приложения Google)
# Mail.ru:  SMTP_HOST=smtp.mail.ru     SMTP_PORT=465  (пароль для внешнего приложения)

PORT=3000
